    varchar mobile UK
    text name
    text language
    timestamptz profile_completed_at
    boolean is_active }
  partners { bigint id PK
    varchar mobile UK
    text name
    text email UK
    timestamptz email_verified_at
    timestamptz signup_completed_at
    text status }
  partner_references { bigint id PK
    bigint partner_id FK
    smallint position
    text name
    varchar mobile
    text relation
    timestamptz verified_at
    timestamptz created_at
    timestamptz last_modified
    boolean is_active }
  partner_documents { bigint id PK
    bigint partner_id FK
    bigint document_type_id FK
    text status
    text file_url
    text file_back_url
    char number_last4
    text name_on_document
